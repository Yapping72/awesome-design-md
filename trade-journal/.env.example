POSTGRES_USER=journal
POSTGRES_PASSWORD=journal
POSTGRES_DB=trade_journal
DATABASE_URL=postgresql+psycopg2://journal:journal@db:5432/trade_journal
CORS_ORIGINS=http://localhost:5173

# VITE_API_URL is NOT needed for `docker compose up` — the frontend calls
# relative /api/* paths, proxied same-origin to the backend by nginx
# (frontend/nginx.conf), so the built image works at any host without a
# rebuild. It's only relevant for local `npm run dev`; see
# frontend/.env.example.
